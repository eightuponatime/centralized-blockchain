{{ define "index.tmpl" }}
<!DOCTYPE html>
<html>

<head>
    <title>Blockchain Visualization</title>
    <style>
        body {
            font-family: sans-serif;
            margin: 20px;
            text-align: center;
        }

        .blockchain-container {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .block {
            width: 150px;
            height: 150px;
            border: 2px solid #333;
            background-color: #e0f7fa;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            font-size: 12px;
            padding: 10px;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        }

        .block p {
            margin: 2px 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .arrow {
            width: 50px;
            height: 10px;
            position: relative;
            top: 75px;
        }

        .arrow::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 2px;
            background: #333;
        }

        .arrow::after {
            content: '';
            position: absolute;
            top: 50%;
            right: -5px;
            border-left: 10px solid #333;
            border-top: 5px solid transparent;
            border-bottom: 5px solid transparent;
            transform: translateY(-50%);
        }
    </style>
</head>

<body>
    <h1>Blockchain</h1>
    <div class="blockchain-container">
        {{ range $block := .Blocks }}
        <div class="block">
            <p>Index: {{ $block.Index }}</p>
            <p>Hash: {{ slice $block.Hash 0 8 }}...</p>
            <p>Prev: {{ slice $block.PrevHash 0 8 }}...</p>
            <p>Timestamp: {{ slice $block.Timestamp 0 10 }}</p>
            <p>Amount: {{ $block.Amount }}</p>
            <p>PaymentDate: {{ slice $block.PaymentDate 0 10}}</p>
            <p>Client: {{ $block.ClientId }}, Trainer: {{ $block.TrainerId }}</p>
            <p>HMAC: {{ slice $block.HMAC 0 8}}...</p>
        </div>
        {{ if $block.ShowArrow }}
        <div class="arrow"></div>
        {{ end }}
        {{ end }}
    </div>
</body>

</html>
{{ end }}